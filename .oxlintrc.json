{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@supabase/supabase-js",
            "message": "Solo services/ puede importar Supabase. Usa un servicio desde '../services'."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/services/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@supabase/supabase-js",
                "message": "Los componentes son presentacionales: nada de Supabase."
              }
            ],
            "patterns": [
              {
                "group": ["**/hooks", "**/hooks/**", "**/services", "**/services/**", "**/context", "**/context/**"],
                "message": "components/ solo recibe props: prohibido importar hooks, services o context."
              }
            ]
          }
        ]
      }
    }
  ]
}
