# Copia este archivo a .env y completa los valores.
# Local: toma URL y la anon/publishable key de `npx supabase status`.
# NUNCA pongas aquí la service_role / secret key: el frontend solo usa la anon key y la seguridad la da RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# true = usa el servicio mock en memoria (demo sin base de datos); false = Supabase real.
VITE_USE_MOCK=false
